# ============================================================
# Переменные задаются в Railway dashboard → Service → Variables
# ============================================================

# --- Listmonk admin (задать ДО первого деплоя) ---
LISTMONK_app__admin_username=admin
LISTMONK_app__admin_password=CHANGE_ME_STRONG_PASSWORD

# --- URL сайта (ваш домен через Cloudflare) ---
# Пример: https://mail.yourdomain.com
LISTMONK_app__root_url=https://YOUR_DOMAIN

# --- PostgreSQL (проставляются автоматически Railway Postgres плагином) ---
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# ============================================================
# BREVO SMTP — настраивается в Listmonk UI после первого входа:
# Settings → SMTP → Add server
#   Host:     smtp-relay.brevo.com
#   Port:     587
#   Auth:     LOGIN
#   Username: ВАШ_EMAIL_В_BREVO
#   Password: SMTP_KEY из Brevo dashboard → SMTP & API
#   TLS:      STARTTLS
# ============================================================
