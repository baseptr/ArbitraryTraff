# Эти переменные задаются в Railway dashboard → Variables
# PostgreSQL vars проставляются автоматически когда добавляешь Postgres плагин

# Задать вручную до первого деплоя:
LISTMONK_app__admin_username=some_pass
LISTMONK_app__admin_password=CHANGE_ME_STRONG_PASSWORD

# Проставляются автоматически Railway Postgres плагином:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# SMTP (Amazon SES) — добавить после настройки SES
# Задаются в Listmonk dashboard → Settings → SMTP, не через env
